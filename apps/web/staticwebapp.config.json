{
  "platform": {
    "apiRuntime": "node:22"
  },
  "navigationFallback": {
    "rewrite": "index.html",
    "exclude": ["*.{css,scss,sass,less,jpg,jpeg,png,gif,ico,svg,webp,js}"]
  },
  "routes": [
    {
      "route": "/.swa/*",
      "headers": {
        "Cache-Control": "no-cache"
      }
    }
  ]
}
